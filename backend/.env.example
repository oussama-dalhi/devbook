# backend/.env.example
# PostgreSQL connection string
DATABASE_URL=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ImageKit private API key (ImageKit dashboard > Developer options)
IMAGEKIT_PRIVATE_KEY=

# "development" locally, "production" on the server
NODE_ENV=development

# Optional. Defaults to 3000
PORT=3000

# Optional. Number of reverse proxies in front of the API (usually 1 in production).
# Leave empty locally.
TRUST_PROXY=
